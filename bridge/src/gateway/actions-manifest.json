{
  "v": 1,
  "platform": "qq",
  "adapter": "qq-bridge",
  "notes": [
    "能力唯一事实源：/v1/actions 通用分发按本清单做 payload 校验与 handler 路由；GET /v1/actions/manifest 暴露本文件（网关按它生成 chat_qq_* 工具目录）。",
    "wired:true 表示适配器内已有 handler；wired:false 仅契约声明（阶段 1），调用回 E_UNSUPPORTED，接线在阶段 2（adapter-tools 任务）逐条翻转。",
    "configFlag 对应 socialV2.tools.<flag>：宿主只在开关开启时注入 handler，关 = 未接线语义。",
    "旧 MCP 工具的 token 参数不再进入线缆契约：/v1/actions 的身份就是 HMAC 签名（x-gateway-secret），不再有第二次会话令牌。",
    "payload.key（如 group:456）可省略，缺省由 envelope.target（kind:conversationId）推导；显式传 key 可跨会话操作（沿用旧工具语义）。",
    "kind=sensitive 的动作（set_wake）在网关侧需显式允许后才会暴露给模型。"
  ],
  "actions": [
    {
      "type": "send_text",
      "summary": "发送纯文本（回合文本自动投递走这里）",
      "kind": "write",
      "wired": true,
      "payloadSchema": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    },
    {
      "type": "reply",
      "summary": "回复指定消息（带引用语义的文本发送）",
      "kind": "write",
      "wired": true,
      "legacyTool": "qq_reply",
      "payloadSchema": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "replyToMessageId": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    {
      "type": "mark_read",
      "summary": "推进已读水位",
      "kind": "write",
      "wired": true,
      "configFlag": "markRead",
      "legacyTool": "qq_mark_read",
      "payloadSchema": {
        "type": "object",
        "required": [
          "throughSeq"
        ],
        "properties": {
          "throughSeq": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "type": "send_message",
      "summary": "分句发送消息（支持 gapMode/gapMs/atUserId，主发送通道）",
      "kind": "write",
      "configFlag": "sendMessage",
      "legacyTool": "qq_send_message",
      "payloadSchema": {
        "type": "object",
        "required": [
          "messages"
        ],
        "properties": {
          "messages": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "maxItems": 20
          },
          "replyToMessageId": {
            "type": [
              "string",
              "number"
            ]
          },
          "atUserId": {
            "type": [
              "string",
              "number"
            ]
          },
          "gapMode": {
            "enum": [
              "auto",
              "fixed",
              "byLength"
            ]
          },
          "gapMs": {
            "type": "integer",
            "minimum": 0
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "maxItems": 20
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    {
      "type": "send_burst",
      "summary": "群内连发（连发器状态机）",
      "kind": "write",
      "configFlag": "sendBurst",
      "legacyTool": "qq_send_burst",
      "payloadSchema": {
        "type": "object",
        "required": [
          "groupId",
          "messages"
        ],
        "properties": {
          "groupId": {
            "type": [
              "string",
              "number"
            ]
          },
          "messages": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "maxItems": 20
          }
        }
      }
    },
    {
      "type": "send_group_message",
      "summary": "直发群消息（closed-agent 旧模式）",
      "kind": "write",
      "wired": false,
      "legacyTool": "qq_send_group_message",
      "payloadSchema": {
        "type": "object",
        "required": [
          "groupId",
          "message"
        ],
        "properties": {
          "groupId": {
            "type": [
              "string",
              "number"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "replyToMessageId": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    {
      "type": "send_private_message",
      "summary": "直发私聊消息（closed-agent 旧模式）",
      "kind": "write",
      "wired": false,
      "legacyTool": "qq_send_private_message",
      "payloadSchema": {
        "type": "object",
        "required": [
          "userId",
          "message"
        ],
        "properties": {
          "userId": {
            "type": [
              "string",
              "number"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "replyToMessageId": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    {
      "type": "poke",
      "summary": "拍一拍（群聊需 targetUserId）",
      "kind": "write",
      "configFlag": "sendPoke",
      "legacyTool": "qq_send_poke",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "targetUserId": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    {
      "type": "wait",
      "summary": "登记等待新消息：立即返回「已登记」，新消息到达后由网关以唤醒事件回推（无需阻塞轮询）",
      "kind": "read",
      "wired": true,
      "configFlag": "waitMessages",
      "legacyTool": "qq_wait_for_messages",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "purpose": {
            "enum": [
              "messages",
              "reply"
            ]
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600000
          },
          "minNewMessages": {
            "type": "integer",
            "minimum": 1
          },
          "quietMs": {
            "type": "integer",
            "minimum": 0
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    {
      "type": "set_wake",
      "summary": "设置唤醒配置（敏感：网关需显式允许）",
      "kind": "sensitive",
      "configFlag": "setWakeConfig",
      "legacyTool": "qq_set_wake_config",
      "payloadSchema": {
        "type": "object",
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "type": "object"
          },
          "throughSeq": {
            "type": "integer",
            "minimum": 0
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    {
      "type": "social_state",
      "summary": "读取社交状态机快照",
      "kind": "read",
      "configFlag": "socialState",
      "legacyTool": "qq_social_state",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    {
      "type": "get_prompt",
      "summary": "读取当前唤醒 prompt 终稿",
      "kind": "read",
      "configFlag": "getPrompt",
      "legacyTool": "qq_get_prompt",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    {
      "type": "get_unread",
      "summary": "读取未读消息（可 afterSeq 增量）",
      "kind": "read",
      "configFlag": "getUnread",
      "legacyTool": "qq_get_unread_messages",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "afterSeq": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "type": "get_recent",
      "summary": "读取最近消息（可 offset 翻页）",
      "kind": "read",
      "configFlag": "getRecent",
      "legacyTool": "qq_get_recent_messages",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "type": "get_my_recent",
      "summary": "读取自己最近发出的消息",
      "kind": "read",
      "configFlag": "getMyRecent",
      "legacyTool": "qq_get_my_recent_messages",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        }
      }
    },
    {
      "type": "get_message_detail",
      "summary": "按 messageId 读单条消息详情",
      "kind": "read",
      "configFlag": "getMessageDetail",
      "legacyTool": "qq_get_message_detail",
      "payloadSchema": {
        "type": "object",
        "required": [
          "messageId"
        ],
        "properties": {
          "messageId": {
            "type": [
              "string",
              "number"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    {
      "type": "get_forward_msg",
      "summary": "读取合并转发消息（内含二段媒体拉取）",
      "kind": "read",
      "configFlag": "getForwardMsg",
      "legacyTool": "qq_get_forward_msg",
      "payloadSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "number"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    {
      "type": "get_active_members",
      "summary": "读取当前会话活跃成员",
      "kind": "read",
      "configFlag": "getActiveMembers",
      "legacyTool": "qq_get_active_members",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      }
    },
    {
      "type": "get_group_members",
      "summary": "读取群成员列表",
      "kind": "read",
      "configFlag": "getGroupMembers",
      "legacyTool": "qq_get_group_members",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        }
      }
    },
    {
      "type": "list_groups",
      "summary": "列出已接入群（含白名单过滤）",
      "kind": "read",
      "wired": false,
      "legacyTool": "qq_list_groups",
      "payloadSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "type": "get_history",
      "summary": "读取群历史消息（OneBot get_group_msg_history）",
      "kind": "read",
      "wired": false,
      "legacyTool": "qq_get_group_history",
      "payloadSchema": {
        "type": "object",
        "required": [
          "groupId"
        ],
        "properties": {
          "groupId": {
            "type": [
              "string",
              "number"
            ]
          },
          "messageSeq": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "type": "send_voice",
      "summary": "发送语音（TTS/音源引用）",
      "kind": "write",
      "configFlag": "sendVoice",
      "legacyTool": "qq_send_voice",
      "payloadSchema": {
        "type": "object",
        "required": [
          "voice"
        ],
        "properties": {
          "voice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "label": {
            "type": "string",
            "maxLength": 100
          },
          "verify": {
            "type": "boolean"
          },
          "readback": {
            "type": "boolean"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    {
      "type": "list_voices",
      "summary": "列出可用音色",
      "kind": "read",
      "configFlag": "sendVoice",
      "legacyTool": "qq_list_voices",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "probe": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "type": "ask",
      "summary": "把 DSH 会话的提问转达给本会话（网关 pending 转发，通知性质、不自动应答）",
      "kind": "write",
      "wired": true,
      "payloadSchema": {
        "type": "object",
        "required": [
          "questions"
        ],
        "properties": {
          "questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "minItems": 1,
            "maxItems": 5
          },
          "eventId": {
            "type": "string",
            "maxLength": 128
          },
          "sessionId": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    {
      "type": "approve",
      "summary": "把 DSH 会话的工具审批请求转达给本会话（网关 pending 转发，通知性质）",
      "kind": "write",
      "wired": true,
      "payloadSchema": {
        "type": "object",
        "required": [
          "toolName"
        ],
        "properties": {
          "toolName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          },
          "callId": {
            "type": "string",
            "maxLength": 128
          },
          "eventId": {
            "type": "string",
            "maxLength": 128
          },
          "sessionId": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    {
      "type": "send_image",
      "summary": "发送图片（多媒体记忆层发送适配）",
      "kind": "write",
      "configFlag": "sendImage",
      "legacyTool": "qq_send_image",
      "payloadSchema": {
        "type": "object",
        "properties": {
          "fileRef": {
            "type": "string",
            "description": "本地图片路径（限白名单媒体目录）"
          },
          "url": {
            "type": "string",
            "description": "https 图片地址"
          },
          "base64": {
            "type": "string",
            "description": "图片 base64 内容"
          },
          "caption": {
            "type": "string",
            "maxLength": 300,
            "description": "随图配文"
          },
          "replyToMessageId": {
            "type": [
              "string",
              "number"
            ]
          },
          "atUserId": {
            "type": [
              "string",
              "number"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  ]
}
